rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =============================================================
    // Assumed Data Model
    //
    // Collection: accounts
    // Document ID: Firebase Authentication UID (accounts/{uid})
    // Fields:
    //   - displayName: string, required, 2..120 chars; owner editable
    //   - email: string, required, <=254 chars, must match verified auth token;
    //     immutable to clients
    //   - settings: empty map, required; reserved for future server-managed data
    //   - subscription: {plan, status}, required; values mirror the trusted
    //     server subscription state and are immutable to clients
    //   - createdAt: timestamp, required, set at creation and immutable
    //   - updatedAt: timestamp, required, set with serverTimestamp on writes
    //
    // No other Firestore collections or client queries are present in this app.
    // Paid subscription state is authoritative in the verified API/PostgreSQL
    // backend. A trusted server may mirror it here using Admin SDK; clients
    // cannot grant themselves a paid plan.
    // =============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner(userId) {
      return isOwner(userId);
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function isValidEmail(email) {
      return email is string && email.size() <= 254 &&
        email.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$');
    }

    function isRecent(time) {
      return time is timestamp &&
        time > request.time - duration.value(5, 'm') &&
        time <= request.time;
    }

    function isValidSettings(settings) {
      return settings is map && settings.size() == 0 &&
        settings.keys().hasOnly([]);
    }

    function isValidSubscription(subscription) {
      return subscription is map && subscription.size() == 2 &&
        subscription.keys().hasAll(['plan', 'status']) &&
        subscription.keys().hasOnly(['plan', 'status']) &&
        subscription.plan in ['free', 'plus_monthly', 'plus_yearly'] &&
        subscription.status in ['free', 'trialing', 'active', 'past_due', 'cancelled', 'expired'];
    }

    // This validator is applied to both create and update. Create rules below
    // further constrain the initial subscription to the free tier.
    function isValidUser(data) {
      return hasRequiredFields(data, [
          'displayName', 'email', 'settings', 'subscription', 'createdAt', 'updatedAt'
        ]) &&
        hasOnlyAllowedFields(data, [
          'displayName', 'email', 'settings', 'subscription', 'createdAt', 'updatedAt'
        ]) &&
        data.displayName is string && data.displayName.size() >= 2 &&
        data.displayName.size() <= 120 &&
        isValidEmail(data.email) &&
        isValidSettings(data.settings) &&
        isValidSubscription(data.subscription) &&
        data.createdAt is timestamp && isRecent(data.updatedAt) &&
        data.email == request.auth.token.email;
    }

    match /accounts/{userId} {
      // Account data includes PII, so only its authenticated owner can read it.
      allow get: if isOwner(userId);
      allow list: if false;

      // A client can only create its own account with the initial free plan.
      allow create: if isOwner(userId) && isDocOwner(userId) && uidUnchanged() &&
        isValidUser(request.resource.data) &&
        request.resource.data.subscription == {'plan': 'free', 'status': 'free'} &&
        isValidSettings(request.resource.data.settings) &&
        isRecent(request.resource.data.createdAt) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      // Owners can edit only their display name. Email, timestamps, settings,
      // and subscription rights cannot be changed by the client.
      allow update: if isOwner(userId) && isDocOwner(userId) && uidNotModified() &&
        isValidUser(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt']) &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.settings == resource.data.settings &&
        request.resource.data.subscription == resource.data.subscription &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time;

      // The account screen lets an authenticated owner delete app data while
      // preserving the Firebase Authentication login.
      allow delete: if isOwner(userId);
    }

    // Default deny for every other collection and all account subcollections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
